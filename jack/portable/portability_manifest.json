    "retrieve_operator_asset_sovereignty_contract_when_not_already_available_in_verified_form",
    "retrieve_jack_contract_when_not_already_available_in_verified_form",
    "consult_relevant_known_prior_work_corrections_and_verified_state",
    "reuse_known_valid_state_where_usable",
    "identify_active_thread_and_nearest_valid_continuation",
    "hydrate_only_material_unknown_changed_conflicting_or_exact_source_delta",
    "bind_current_literal_operator_instruction_and_operation_class",
    "apply_continuity_kernel_only_as_bridge_when_full_source_context_is_limited",
    "map_platform_tools_without_rewriting_objective_or_scope",
    "execute_operator_aligned_path_within_requested_operation",
    "verify_material_state_and_mission_outcome",
    "persist_verified_gain_and_resumable_next_state_when_authorized"
