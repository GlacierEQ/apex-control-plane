  "projection_policy": {
    "source_mutable_only_at_execution_home": true,
    "derived_projections_read_only": true,
    "adapter_may_reinterpret_operator_objective": false,
    "adapter_may_expand_operator_operation_scope": false,
    "adapter_may_rank_operator_assets_without_request": false,
    "adapter_may_dispose_operator_assets_without_direction": false,
    "adapter_may_create_secondary_approval_authority": false,
    "adapter_may_force_rediscovery_of_usable_known_state": false,
    "adapter_may_replace_continuation_with_reconstruction": false,
    "adapter_may_map_tools": true,
    "adapter_may_compress_for_context": true,
    "adapter_must_preserve_directional_semantics": true,
    "adapter_must_preserve_operation_class": true,
    "adapter_must_preserve_source_identity": true,
    "adapter_must_reuse_known_state_where_usable": true,
    "adapter_must_hydrate_only_material_delta": true,
    "source_gap_must_be_disclosed": true
