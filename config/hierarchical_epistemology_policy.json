{
  "schema": "glaciereq.hierarchical-epistemology.v1.1",
  "authority": "operator_intent",
  "objective": "maximum_coherent_advance",
  "levels": [
    "mission",
    "authority",
    "claim",
    "evidence",
    "strategy",
    "execution",
    "verification",
    "learning"
  ],
  "invariants": [
    "UNKNOWN != FALSE",
    "GENERATED != EXECUTED != VERIFIED",
    "consensus does not create truth",
    "artifact-only work is not mission progress",
    "relevant known state is reused before rediscovery",
    "contradictions remain visible until resolved",
    "latest is a routing cursor, not replacement authority",
    "merge transcribe compound before retirement",
    "retirement requires verified UNIQUE_CONTRIBUTION=0",
    "every material promotion has a receipt"
  ],
  "resource_policy": "adaptive_evidence_driven",
  "continuation_policy": {
    "low_signal": "reroute_method_without_scope_loss",
    "conflict": "preserve_and_investigate",
    "verified": "continue_if_mission_has_remaining_work",
    "fixed_global_worker_caps": false,
    "fixed_global_retrieval_caps": false,
    "global_hard_stop_semantics": false
  },
  "self_correction": {
    "preserve_known_good_state": true,
    "reroute_after_failure": true,
    "unresolved_failure_escalates": true,
    "retry_policy": "adaptive"
  }
}
