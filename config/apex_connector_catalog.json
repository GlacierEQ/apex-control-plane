{
  "schema_version": 1,
  "catalog_id": "apex-connector-catalog",
  "version": 3,
  "profiles": {
    "repository_integrity": [
      "github"
    ],
    "evidence_intake": [
      "dropbox"
    ],
    "current_source_review": [
      "google_workspace"
    ],
    "knowledge_continuity": [
      "notion",
      "mem"
    ],
    "structured_state_review": [
      "supabase"
    ],
    "api_verification": [
      "postman"
    ]
  },
  "connectors": {
    "github": {
      "data_class": "repository_metadata",
      "read_operations": [
        "repository.read_metadata",
        "branch_protection.read",
        "pull_request.read",
        "commit.read",
        "workflow_run.read",
        "issue.read"
      ],
      "write_operations": {
        "issue.create": {
          "enabled": true,
          "authorization_required": true,
          "idempotency_required": true,
          "terminal_readback_required": true,
          "destructive": false
        },
        "pull_request.create": {
          "enabled": true,
          "authorization_required": true,
          "idempotency_required": true,
          "terminal_readback_required": true,
          "destructive": false
        }
      }
    },
    "dropbox": {
      "data_class": "evidence_artifact",
      "read_operations": [
        "file.search",
        "file.list",
        "file.metadata.read",
        "file.extract_text",
        "file.download_preserve"
      ],
      "write_operations": {
        "file.upload": {
          "enabled": false,
          "authorization_required": true,
          "idempotency_required": true,
          "terminal_readback_required": true,
          "destructive": false
        },
        "file.move": {
          "enabled": false,
          "authorization_required": true,
          "idempotency_required": true,
          "terminal_readback_required": true,
          "destructive": false
        }
      }
    },
    "google_workspace": {
      "data_class": "current_source",
      "read_operations": [
        "drive.search",
        "document.read",
        "spreadsheet.read",
        "presentation.read"
      ],
      "write_operations": {
        "document.create": {
          "enabled": true,
          "authorization_required": true,
          "idempotency_required": true,
          "terminal_readback_required": true,
          "destructive": false
        },
        "document.update": {
          "enabled": true,
          "authorization_required": true,
          "idempotency_required": true,
          "terminal_readback_required": true,
          "destructive": false
        }
      }
    },
    "notion": {
      "data_class": "knowledge_record",
      "read_operations": [
        "page.search",
        "page.read",
        "database.read"
      ],
      "write_operations": {
        "page.create": {
          "enabled": false,
          "authorization_required": true,
          "idempotency_required": true,
          "terminal_readback_required": true,
          "destructive": false
        },
        "page.update": {
          "enabled": false,
          "authorization_required": true,
          "idempotency_required": true,
          "terminal_readback_required": true,
          "destructive": false
        }
      }
    },
    "mem": {
      "data_class": "continuity_record",
      "read_operations": [
        "record.search",
        "record.read"
      ],
      "write_operations": {
        "note.create": {
          "enabled": true,
          "authorization_required": true,
          "idempotency_required": true,
          "terminal_readback_required": true,
          "destructive": false
        },
        "note.update": {
          "enabled": true,
          "authorization_required": true,
          "idempotency_required": true,
          "terminal_readback_required": true,
          "destructive": false
        },
        "collection.create": {
          "enabled": true,
          "authorization_required": true,
          "idempotency_required": true,
          "terminal_readback_required": true,
          "destructive": false
        },
        "collection.update": {
          "enabled": true,
          "authorization_required": true,
          "idempotency_required": true,
          "terminal_readback_required": true,
          "destructive": false
        }
      }
    },
    "supabase": {
      "data_class": "structured_state",
      "read_operations": [
        "schema.read",
        "table.read",
        "query.read"
      ],
      "write_operations": {
        "row.insert": {
          "enabled": true,
          "authorization_required": true,
          "idempotency_required": true,
          "terminal_readback_required": true,
          "destructive": false
        },
        "row.update": {
          "enabled": true,
          "authorization_required": true,
          "idempotency_required": true,
          "terminal_readback_required": true,
          "destructive": false
        }
      }
    },
    "postman": {
      "data_class": "api_contract",
      "read_operations": [
        "workspace.read",
        "collection.read",
        "spec.read",
        "monitor.read"
      ],
      "write_operations": {
        "collection.create": {
          "enabled": true,
          "authorization_required": true,
          "idempotency_required": true,
          "terminal_readback_required": true,
          "destructive": false
        },
        "collection.update": {
          "enabled": true,
          "authorization_required": true,
          "idempotency_required": true,
          "terminal_readback_required": true,
          "destructive": false
        },
        "spec.create": {
          "enabled": true,
          "authorization_required": true,
          "idempotency_required": true,
          "terminal_readback_required": true,
          "destructive": false
        },
        "monitor.create": {
          "enabled": true,
          "authorization_required": true,
          "idempotency_required": true,
          "terminal_readback_required": true,
          "destructive": false
        }
      }
    }
  },
  "security": {
    "credentials_in_source": false,
    "bridge_receipt_required": true,
    "external_write_requires_source_bound_authorization": true,
    "scheduled_connector_writes": false,
    "maximum_receipt_age_seconds": 86400
  }
}
