{
  "schema_version": "2.0.0",
  "name": "APEX Mission Outcome Uplift",
  "fail_closed": false,
  "execution_semantics": "measure_progress_enrich_next_action_never_erase_execution",
  "principle": "Assistant activity is not automatically mission progress. Preserve and verify useful intermediate work, classify its actual effect honestly, then use the gap between activity and mission outcome to drive the next highest-impact execution step.",
  "required_for_mutation": false,
  "mission_outcome_measurement_required": true,
  "missing_outcome_behavior": "persist_truthfully_then_continue_toward_mission_outcome",
  "activity_only_behavior": "classify_as_intermediate_gain_and_raise_next_action_ceiling",
  "invalid_outcome_claim_behavior": "record_uplift_finding_do_not_promote_claim",
  "allowed_transition_kinds": [
    "proved",
    "disproved",
    "attributed",
    "quantified",
    "acquired",
    "corrected",
    "closed",
    "executed",
    "filed",
    "provider_state_changed",
    "system_behavior_changed",
    "genuine_external_boundary"
  ],
  "activity_only_transition_kinds": [
    "artifact_created",
    "ledger_created",
    "matrix_created",
    "summary_created",
    "packet_created",
    "index_created",
    "commit_created",
    "issue_updated",
    "report_created",
    "plan_created"
  ],
  "activity_only_evidence_prefixes": [
    "artifact",
    "ledger",
    "matrix",
    "summary",
    "packet",
    "report",
    "plan",
    "linear-update"
  ],
  "boundary_transition_kind": "genuine_external_boundary",
  "state_transition_requires_distinct_before_after": true,
  "state_transition_requires_evidence": true,
  "boundary_requires_routes_exhausted": true,
  "boundary_requires_reason": true,
  "boundary_requires_evidence": true,
  "uplift": {
    "preserve_intermediate_verified_gains": true,
    "never_promote_activity_only_artifact_to_mission_outcome": true,
    "never_block_persistence_only_because_mission_outcome_is_not_yet_reached": true,
    "after_intermediate_gain_select_next_material_frontier": true,
    "provider_or_external_boundary_is_route_local": true
  }
}
