  "laws": [
    "CONTEXT BEFORE MUTATION",
    "BEFORE STARTING, DETERMINE WHETHER IT IS ALREADY STARTED",
    "CONTINUE AND EXTEND EXISTING VALID WORK BEFORE RESTARTING",
    "BEFORE MAKING, DISCOVER WHO NEEDS, OWNS, CONSUMES, DEPENDS ON, OR OVERLAPS WITH IT",
    "PRESERVE AND LINK VALID PRIOR CAPABILITY",
    "TOPOLOGY CONFLICTS REQUIRE RESOLUTION BEFORE MATERIAL MUTATION",
    "OPERATOR INTENT CONTROLS PROJECT DIRECTION",
    "NEW ROOTS REQUIRE OPERATOR DIRECTION OR EVIDENCE THAT CONTINUATION CANNOT SATISFY THE TARGET"
  ],
  "security": {
    "never_embed_secrets": true,
    "do_not_require_sensitive_payloads_in_receipts": true,
    "store_pointers_and_roles_not_private_content": true
  }
