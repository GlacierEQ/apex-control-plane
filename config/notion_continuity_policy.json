  "tool_aliases": {
    "notion_search": [
      "notion.search"
    ],
    "notion_fetch": [
      "notion.fetch"
    ],
    "work_search": [
      "notion.search",
      "github.search",
      "github.search_repositories",
      "github.search_commits",
      "github.search_issues",
      "files.search",
      "personal_context.search",
      "google_drive.search",
      "dropbox.search",
      "box.search"
