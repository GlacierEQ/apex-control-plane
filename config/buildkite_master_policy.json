  "pipeline_contract": {
    "pipeline_as_code": true,
    "require_step_keys": true,
    "require_explicit_queue": true,
    "require_timeouts": true,
    "require_exact_commit_verification": true,
    "require_fail_closed_shell": true,
    "require_receipt_artifacts": true,
    "reject_inline_secret_assignments": true,
    "dynamic_upload_reject_secrets": true,
    "dynamic_upload_requires_stable_keys": true,
    "parallel_fanout_parent": "buildkite-master",
    "required_parallel_keys": [
      "source-fidelity",
      "registry-audit",
      "automation-safety",
      "full-regression"
    ],
    "receipt_fanin_key": "verified-receipt",
    "receipt_requires_all_parallel_keys": true,
    "failure_diagnostics_required": true
  },
  "receipt_contract": {
    "required_identity": [
      "commit",
      "branch",
      "build_id",
      "build_number",
      "pipeline"
    ],
    "required_proof": [
      "test_result",
      "artifact_digest",
      "automation_safety",
      "full_regression",
      "readback"
    ],
    "completion_rule": "no_verified_delta_no_success"
  },
  "security_target": {
    "cluster_isolation": true,
    "least_privilege_api_tokens": true,
    "cluster_scoped_secrets": true,
    "secret_access_policies": true,
    "pipeline_signing": "target_for_sensitive_self_hosted_lanes",
    "ephemeral_or_reimaged_agents": "preferred_for_untrusted_or_high_risk_workloads",
    "manual_override_policy": "break_glass_only_with_receipt",
    "scheduled_repository_secrets": "avoid_when_short_lived_or_platform_identity_is_sufficient",
    "unattended_repository_history_mutation": "forbidden"
  },
  "known_unverified_requirements": [
    "live Buildkite organization and cluster inventory",
    "current agent versions and queue health",
    "current secret policies and token expirations",
    "restricted deployers team existence and membership",
    "live oracle-arm64 proof build on the promoted lineage",
    "current GitHub Buildkite required-check mapping",
    "authenticated active-build inventory for organization casey-1",
    "current live job identity for macos-self and oracle-arm64",
    "current FILEBOSS Buildkite build state",
    "available concurrent capacity on macos-self"
  ],
  "live_readback_contract": {
    "observation_only": true,
    "active_build_states": [
      "scheduled",
      "running",
      "failing",
      "blocked",
      "waiting"
    ],
    "required_resources": [
      "active_builds",
      "pipelines",
      "clusters",
      "queues",
      "agents",
      "agent_token_metadata",
      "secret_metadata"
    ],
    "credential_values_forbidden": true,
    "missing_scope_state": "UNVERIFIED_MISSING_SCOPE"
  },
  "github_projection_contract": {
    "exact_commit_required": true,
    "context_prefix": "buildkite/",
    "success_state": "success",
    "target_url_must_identify_buildkite_build": true,
    "projection_does_not_replace_terminal_receipt": true
  },
  "terminal_state_separation": {
    "pipeline_or_build_created": "execution_started_only",
    "build_passed": "build_terminal_success_only",
    "domain_completion": "requires_domain_specific_readback",
