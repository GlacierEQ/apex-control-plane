{
  "schema_version": "1.0.0",
  "connector_key": "desktop_commander.glacier",
  "role": "local_agent_execution_bridge",
  "authority": {
    "source_system": "GlacierEQ/UDC",
    "backend_is_source_authority": false,
    "live_device_state_is_runtime_only": true
  },
  "runtime": {
    "plane": "supabase-backend-ops",
    "bridge_function": "apex-desktop-commander-bridge",
    "transport": "outbound_signed_bridge_v1",
    "inbound_desktop_port_required": false
  },
  "tables": {
    "devices": "desktop_commander_devices_v1",
    "jobs": "desktop_commander_jobs_v1",
    "receipts": "desktop_commander_receipts_v1",
    "nonces": "desktop_commander_nonces_v1",
    "operation_policy": "desktop_commander_operation_policy_v1"
  },
  "allowed_operations": [
    "read_file",
    "read_multiple_files",
    "list_directory",
    "search_files",
