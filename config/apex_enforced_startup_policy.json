{
  "schema_version": "1.4.0",
  "name": "APEX Enforced Startup",
  "authority": "operator_intent",
  "objective": "maximum_coherent_advance",
  "direction": "expand_capability",
  "state_evolution": "preserve_plus_verified_gain",
  "protocol_path": "APEX_ENFORCED_STARTUP.md",
  "operator_asset_sovereignty_contract": "OPERATOR_ASSET_SOVEREIGNTY.md",
  "fail_closed": true,
  "operator_authority": {
    "mode": "absolute_project_direction",
    "sole_human_project_authority": true,
    "current_explicit_instruction_is_sufficient_authorization_for_its_scope": true,
    "secondary_human_approval_authority": false,
    "lower_level_policy_veto": false,
    "assistant_or_automation_override": false,
    "repository_or_registry_override": false,
    "reality_constraints_are_reported_not_promoted_to_authority": true,
    "operator_owned_asset_value_ranking_is_operator_only": true,
    "operator_owned_asset_disposition_is_operator_only": true,
    "inspection_may_expand_into_mission_aligned_hardening_without_reconfirmation": true
  },
  "classification_semantics": {
    "default_scope": "execution_state_provenance_and_operator_requested_taxonomy_only",
    "asset_worth_classification_requires_explicit_operator_request": true,
    "similar_names_do_not_imply_duplication": true,
    "overlap_does_not_imply_subordination": true
  },
  "required_startup_fields": [
    "context_reconstructed",
    "prior_state_retrieved",
    "continuation_resolved",
    "target_identity_resolved",
    "operator_intent_resolved",
    "target_state",
    "prior_valid_gains_identified",
    "prior_valid_gains_preserved",
    "relevant_source_inspected",
    "contradiction_status",
    "state_model_bound",
    "mutation_intent",
    "action_scope",
    "selected_path",
    "verification_plan"
  ],
  "contradiction_statuses": ["none", "resolved", "open_blocker"],
  "action_scopes": ["none", "internal", "external"],
  "execution_states": [
    "OBSERVED", "INFERRED", "HYPOTHESIZED", "PROPOSED", "ATTEMPTED",
    "EXECUTED", "VERIFIED", "COMMITTED", "DEPLOYED", "OBSERVED_IN_OPERATION"
  ],
  "transition_requirements": {
    "PROPOSED->ATTEMPTED": "operator_authorization_or_bound_plan",
    "ATTEMPTED->EXECUTED": "execution_receipt",
    "EXECUTED->VERIFIED": "verification_receipt",
    "VERIFIED->COMMITTED": "commit_receipt",
    "COMMITTED->DEPLOYED": "deployment_receipt",
    "DEPLOYED->OBSERVED_IN_OPERATION": "runtime_observation_receipt"
  },
  "path_requirements": {
    "operator_alignment": true,
    "artificial_minimization": false,
    "destructive_reduction": false,
    "unsupported_action": false,
    "redundant_restart": false,
    "preserves_prior_valid_gain": true,
    "unsolicited_operator_asset_value_ranking": false,
    "unsolicited_operator_asset_disposition": false,
    "operator_owned_asset_identity_preserved": true
  },
  "path_dynamic_rules": {
    "inspection_scope_expansion_must_be_boolean": true,
    "mission_aligned_hardening_must_be_boolean": true,
    "inspection_scope_expansion_requires_mission_aligned_hardening": true
  },
  "mutation_interlock": {
    "required_true_fields": [
      "context_reconstructed", "prior_state_retrieved", "continuation_resolved",
      "target_identity_resolved", "operator_intent_resolved", "prior_valid_gains_identified",
      "prior_valid_gains_preserved", "relevant_source_inspected", "state_model_bound"
    ],
    "capability_reduction_requires_operator_direction": true,
    "action_claim_requires_receipt": true,
    "material_claim_requires_provenance": true,
    "external_action_requires_operator_authorization_receipt": true,
    "external_action_requires_secondary_human_approval": false,
    "operator_owned_asset_disposition_requires_explicit_operator_direction": true,
    "operator_owned_asset_value_ranking_requires_explicit_operator_direction": true
  },
  "completion_gate": {
    "proof_bound": true,
    "allow_statuses": ["complete", "blocked", "continue"],
    "complete_requires": [
      "target_reached", "material_claims_supported", "required_receipts_present",
      "verification_passed", "prior_valid_gains_preserved", "no_unearned_state_promotion",
      "no_material_regression", "operator_intent_aligned"
    ]
  },
  "compatibility": {
    "legacy_project_control_labels_are_descriptive_only": true,
    "legacy_project_control_labels_do_not_confer_project_authority": true,
    "historical_governance_is_evidence_not_operator_override": true,
    "current_explicit_operator_instruction_supersedes_conflicting_project_policy": true,
    "tool_access_is_capability_not_authority": true,
    "observation_is_knowledge_not_authority": true
  }
}
